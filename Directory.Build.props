<Project>

  <!--
    Single source of truth for cross-project MSBuild settings.
    <Version> is read by CI on push and must match repo.json (AssemblyVersion + TestingAssemblyVersion).
  -->

  <PropertyGroup Label="Identity">
    <Version>0.2.0.0</Version>
    <Authors>kuchris</Authors>
    <Copyright>Copyright (c) 2026 kuchris. Based on FFXIV-AutoMahjongSolver, Copyright (c) 2026 Xeldar Alz.</Copyright>
    <PackageProjectUrl>https://github.com/kuchris/FFXIV-AutoMahjongSolver</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/kuchris/FFXIV-AutoMahjongSolver</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Determinism" Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
